{
  "manifest_version": 3,
  "name": "MomentumOS Companion",
  "version": "0.7.3",
  "description": "Liest Dating-Profile und Chats mit, legt Kontakte in MomentumOS an und liefert Antwortentwürfe. Sendet nie selbst.",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://tinder.com/*",
    "https://*.bumble.com/*",
    "https://boo.world/*",
    "https://*.badoo.com/*",
    "https://web.whatsapp.com/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://web.telegram.org/*",
    "https://*.linkedin.com/*",
    "https://*.karriere.at/*",
    "https://*.stepstone.at/*",
    "https://*.stepstone.de/*",
    "https://*.willhaben.at/*",
    "https://*.mediajobs.at/*",
    "https://*.jobs.at/*",
    "https://*.hokify.at/*",
    "https://*.indeed.com/*",
    "https://berlinstartupjobs.com/*",
    "https://*.xing.com/*",
    "https://*.arbeitsagentur.de/*",
    "https://jobs.derstandard.at/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tinder.com/*",
        "https://*.bumble.com/*",
        "https://boo.world/*",
        "https://*.badoo.com/*",
        "https://web.whatsapp.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://web.telegram.org/*",
        "https://*.linkedin.com/*",
        "https://*.karriere.at/*",
        "https://*.stepstone.at/*",
        "https://*.stepstone.de/*",
        "https://*.willhaben.at/*",
        "https://*.mediajobs.at/*",
        "https://*.jobs.at/*",
        "https://*.hokify.at/*",
        "https://*.indeed.com/*",
        "https://berlinstartupjobs.com/*",
        "https://*.xing.com/*",
        "https://*.arbeitsagentur.de/*",
        "https://jobs.derstandard.at/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+M" },
      "description": "MomentumOS-Panel öffnen/schließen"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MomentumOS Companion"
  }
}
