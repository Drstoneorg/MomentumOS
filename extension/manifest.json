{
  "manifest_version": 3,
  "name": "MatchOS Companion",
  "version": "0.3.0",
  "description": "Liest Dating-Profile und Chats mit, legt Kontakte in MatchOS an und liefert Antwortentwürfe. Sendet nie selbst.",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://tinder.com/*",
    "https://*.bumble.com/*",
    "https://boo.world/*",
    "https://*.badoo.com/*",
    "https://web.whatsapp.com/*",
    "https://www.instagram.com/*",
    "https://web.telegram.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tinder.com/*",
        "https://*.bumble.com/*",
        "https://boo.world/*",
        "https://*.badoo.com/*",
        "https://web.whatsapp.com/*",
        "https://www.instagram.com/*",
        "https://web.telegram.org/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MatchOS Companion"
  }
}
